{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++: telescope_tests (CPU)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-cpu/telescope_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Enable pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "cmake: build (linux-cpu)"
        },
        {
            "name": "C++: numerics_tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-cpu/numerics/numerics_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Enable pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "cmake: build (linux-cpu)"
        },
        {
            "name": "C++: framework_demo",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-framework/framework/framework_demo",
            "args": ["results/framework"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Enable pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "Python: current file (venv)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": true,
            "env": { "QT_QPA_PLATFORM": "offscreen", "PYTHONPATH": "${workspaceFolder}" }
        }
    ]
}
